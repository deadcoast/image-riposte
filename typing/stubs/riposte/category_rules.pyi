"""Source-derived saved-rule contracts; dynamic reports remain explicit boundaries."""
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import Any
from .errors import RiposteError as RiposteError
from .store import check_root as check_root, safe_child as safe_child, state_relative as state_relative, workspace_lock as workspace_lock
from .title_categories import GENERATED_TITLE as GENERATED_TITLE, MAX_CATEGORIES as MAX_CATEGORIES, Progress as Progress, _media_titles as _media_titles, category_drafts as category_drafts, title_tokens as title_tokens

MAX_RULE_BYTES: int
MISSING_REVISION: str
RESERVED_SLUGS: frozenset[str]

@dataclass(frozen=True)
class CategoryRule:
    label: str
    slug: str
    terms: tuple[str, ...]
    exclusions: tuple[str, ...] = ...
    priority: int = ...

@dataclass(frozen=True)
class RuleSet:
    rules: tuple[CategoryRule, ...]
    revision: str

def _slug(value: str) -> str: ...
def _terms(values: Any, *, required: bool) -> tuple[str, ...]: ...
def rules_document(rules: Sequence[CategoryRule]) -> dict[str, Any]: ...
def _parse_document(document: Any) -> tuple[CategoryRule, ...]: ...
def build_rules(categories: Sequence[str], *, exclusions: Sequence[str] = ..., priorities: Sequence[str] = ..., slugs: Sequence[str] = ...) -> tuple[CategoryRule, ...]: ...
def _unique_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]: ...
def load_rules(root: Path) -> RuleSet: ...
def save_rules(root: Path, rules: Sequence[CategoryRule], *, expected_revision: str) -> RuleSet: ...
def match_title(stem: str, rules: Sequence[CategoryRule]) -> dict[str, Any]: ...
def review_matches(root: Path, rules: Sequence[CategoryRule], *, sample_limit: int = ..., progress: Progress | None = ...) -> dict[str, Any]: ...
def category_rules(root: Path, *, categories: Sequence[str] = ..., exclusions: Sequence[str] = ..., priorities: Sequence[str] = ..., slugs: Sequence[str] = ..., clear: bool = ..., save: bool = ..., expected_revision: str | None = ..., review: bool = ..., progress: Progress | None = ...) -> dict[str, Any]: ...
